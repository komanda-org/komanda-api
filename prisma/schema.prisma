generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanType {
  FREE
  ESSENTIAL
  PRO
}

enum Role {
  PROFISSIONAL
  RESTAURANTE
}

model User {
  id           String        @id @default(uuid()) @db.VarChar(36)
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         Role
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  active       Boolean       @default(true)
  professional Professional?

  @@map("users")
}

model Professional {
  userId          String        @id @map("user_id") @db.VarChar(36)
  fullName        String
  profilePhoto    String?
  mainRole        String
  interestedRoles String[]
  neighborhood    String?
  zipCode         String?
  averageRating   Float? /// @min 0.0 @max 5.0
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  active          Boolean       @default(true)
  user            User          @relation(fields: [userId], references: [id])
  applications    Application[]

  @@map("professionals")
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  REJECTED
  APPROVED
}

enum Shift {
  MORNING
  AFTERNOON
  NIGHT
}

enum ContractType {
  CLT
  FREELANCER
  PJ
  EVENT
  TEMPORARY
}

enum JobStatus {
  ACTIVE
  CLOSED
  FILLED
  EXPIRED
}

model Job {
  id           String        @id @default(uuid()) @db.VarChar(36)
  role         String        @db.VarChar(120)
  shift        Shift
  contractType ContractType  @map("contract_type")
  salary       Decimal?      @map("salary") @db.Decimal(10, 2)
  description  String
  urgent       Boolean       @default(false)
  status       JobStatus     @default(ACTIVE)
  expiresAt    DateTime      @map("expires_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  active       Boolean       @default(true)
  applications Application[]

  @@map("jobs")
}

model Application {
  id             String            @id @default(uuid()) @db.VarChar(36)
  jobId          String            @map("job_id") @db.VarChar(36)
  professionalId String            @map("professional_id") @db.VarChar(36)
  status         ApplicationStatus @default(PENDING)
  appliedAt      DateTime          @default(now()) @map("applied_at")
  job            Job               @relation(fields: [jobId], references: [id])
  professional   Professional      @relation(fields: [professionalId], references: [userId])

  @@unique([jobId, professionalId])
  @@map("applications")
}
