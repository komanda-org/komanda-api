generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
}

enum PlanType {
  FREE
  ESSENTIAL
  PRO
}

enum Role {
  PROFISSIONAL
  RESTAURANTE
}

enum ContractType {
  CLT
  PJ
  FREELANCER
  ESTAGIO
}

enum JobStatus {
  ABERTA
  PAUSADA
  ENCERRADA
}

enum CandidaturaStatus {
  PENDENTE
  APROVADA
  REJEITADA
}

model User {
  id                  String               @id @default(uuid()) @db.VarChar(36)
  email               String               @unique
  passwordHash        String               @map("password_hash")
  role                Role
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  active              Boolean              @default(true)
  professional        Professional?
  passwordResetTokens PasswordResetToken[]
  restaurant          Restaurant?

  @@map("users")
}

model Professional {
  userId            String  @id @map("user_id") @db.VarChar(36)
  fullName          String
  profilePhoto      String?
  mainRole          String
  interestedRoles   String[]
  experienceSummary String? @map("experience_summary") @db.Text
  neighborhood      String?
  zipCode           String?
  averageRating     Float? /// @min 0.0 @max 5.0
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  active          Boolean       @default(true)
  user            User          @relation(fields: [userId], references: [id])
  candidaturas    Candidatura[]
  avaliacoes Avaliacao[]

  @@map("professionals")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model Restaurant {
  userId         String    @id @map("user_id") @db.VarChar(36)
  restaurantName String
  cnpj           String    @unique
  cuisineType    String    @map("cuisine_type")
  description    String
  address        String
  phone          String
  zipCode        String    @map("zip_code")
  logoUrl        String?   @map("logo_url")
  averageRating  Float? /// @min 0.0 @max 5.0
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  active         Boolean   @default(true)
  user           User      @relation(fields: [userId], references: [id])
  jobs           Job[]
  avaliacoes Avaliacao[]

  @@map("restaurants")
}

model Job {
  id           String       @id @default(uuid()) @db.VarChar(36)
  title        String
  description  String       @db.Text
  requirements String?      @db.Text
  salary       Decimal?     @db.Decimal(10, 2)
  contractType ContractType @map("contract_type")
  status       JobStatus    @default(ABERTA)

  restaurantId String     @map("restaurant_id") @db.VarChar(36)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [userId], onDelete: Cascade)

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  active       Boolean       @default(true)
  avaliacoes   Avaliacao[]
  candidaturas Candidatura[]
  avaliacoes   Avaliacao[]

  @@index([restaurantId])
  @@index([status])
  @@map("jobs")
}

model Candidatura {
  id             String            @id @default(uuid()) @db.VarChar(36)
  job            Job               @relation(fields: [jobId], references: [id])
  jobId          String            @db.VarChar(36)
  professional   Professional      @relation(fields: [professionalId], references: [userId])
  professionalId String            @db.VarChar(36)
  status         CandidaturaStatus @default(PENDENTE)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@unique([jobId, professionalId])
  @@index([jobId])
  @@index([professionalId])
  @@index([jobId, status])
  @@map("candidaturas")
}

model Avaliacao {
  id             String       @id @default(uuid()) @db.VarChar(36)
  rating         Int /// @min 1 @max 5
  comment        String?      @db.Text
  // Lado que escreveu a avaliação; o recebedor é sempre o lado oposto
  // (profissional avalia restaurante, ou restaurante avalia profissional).
  avaliadorRole  Role         @map("avaliador_role")
  professional   Professional @relation(fields: [professionalId], references: [userId])
  professionalId String       @db.VarChar(36)
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [userId])
  restaurantId   String       @db.VarChar(36)
  job            Job          @relation(fields: [jobId], references: [id])
  jobId          String       @db.VarChar(36)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([professionalId, restaurantId, jobId, avaliadorRole])

  @@index([professionalId])
  @@index([restaurantId])
  @@index([jobId])
  @@map("avaliacoes")
}
