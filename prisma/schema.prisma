generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

enum PlanType {
  FREE
  ESSENTIAL
  PRO
}

enum Role {
  PROFISSIONAL
  RESTAURANTE
}

enum ContractType {
  CLT
  PJ
  FREELANCER
  ESTAGIO
}

enum JobStatus {
  ABERTA
  PAUSADA
  ENCERRADA
}

enum CandidaturaStatus {
  PENDENTE
  APROVADA
  REJEITADA
}

enum DenunciaStatus {
  PENDENTE
  EM_ANALISE
  RESOLVIDA
}

// Um targetType único cobre perfil/vaga/mensagem sem 3 tabelas (simplificação
// MVP declarada na banca); upgrade pós-MVP: tabela/galeria por alvo se a
// denúncia de mensagem exigir histórico estruturado.
enum DenunciaTargetType {
  PERFIL
  VAGA
  MENSAGEM
}

model User {
  id                  String               @id @default(uuid()) @db.VarChar(36)
  email               String               @unique
  passwordHash        String               @map("password_hash")
  role                Role
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  active              Boolean              @default(true)
  professional        Professional?
  passwordResetTokens PasswordResetToken[]
  restaurant          Restaurant?
  notificacoes        Notificacao[]
  denuncias           Denuncia[]

  @@map("users")
}

model Professional {
  userId            String  @id @map("user_id") @db.VarChar(36)
  fullName          String
  profilePhoto      String?
  mainRole          String
  interestedRoles   String[]
  experienceSummary String? @map("experience_summary") @db.Text
  neighborhood      String?
  zipCode           String?
  averageRating     Float? /// @min 0.0 @max 5.0
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  active          Boolean       @default(true)
  user            User          @relation(fields: [userId], references: [id])
  candidaturas    Candidatura[]
  avaliacoes Avaliacao[]

  @@index([zipCode])
  @@map("professionals")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model Restaurant {
  userId         String    @id @map("user_id") @db.VarChar(36)
  restaurantName String
  cnpj           String    @unique
  cuisineType    String    @map("cuisine_type")
  description    String
  address        String
  phone          String
  zipCode        String    @map("zip_code")
  logoUrl        String?   @map("logo_url")
  averageRating  Float? /// @min 0.0 @max 5.0
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  active         Boolean   @default(true)
  plan           PlanType  @default(FREE)
  user           User      @relation(fields: [userId], references: [id])
  jobs           Job[]
  avaliacoes Avaliacao[]

  @@map("restaurants")
}

model Job {
  id           String       @id @default(uuid()) @db.VarChar(36)
  title        String
  description  String       @db.Text
  requirements String?      @db.Text
  salary       Decimal?     @db.Decimal(10, 2)
  contractType ContractType @map("contract_type")
  status       JobStatus    @default(ABERTA)
  urgent       Boolean      @default(false)
  closedAt     DateTime?    @map("closed_at")

  restaurantId String     @map("restaurant_id") @db.VarChar(36)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [userId], onDelete: Cascade)

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")
  active       Boolean       @default(true)
  candidaturas Candidatura[]
  avaliacoes   Avaliacao[]

  @@index([restaurantId])
  @@index([status])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("jobs")
}

model Candidatura {
  id             String            @id @default(uuid()) @db.VarChar(36)
  job            Job               @relation(fields: [jobId], references: [id])
  jobId          String            @db.VarChar(36)
  professional   Professional      @relation(fields: [professionalId], references: [userId])
  professionalId String            @db.VarChar(36)
  status         CandidaturaStatus @default(PENDENTE)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@unique([jobId, professionalId])
  @@index([jobId])
  @@index([professionalId])
  @@index([jobId, status])
  @@map("candidaturas")
}

model Notificacao {
  id        String   @id @default(uuid()) @db.VarChar(36)
  titulo    String   @db.VarChar(200)
  mensagem  String   @db.Text
  lida      Boolean  @default(false)
  userId    String   @map("user_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notificacoes")
}

model Avaliacao {
  id             String       @id @default(uuid()) @db.VarChar(36)
  rating         Int /// @min 1 @max 5
  comment        String?      @db.Text
  // Lado que escreveu a avaliação; o recebedor é sempre o lado oposto
  // (profissional avalia restaurante, ou restaurante avalia profissional).
  avaliadorRole  Role         @map("avaliador_role")
  professional   Professional @relation(fields: [professionalId], references: [userId])
  professionalId String       @db.VarChar(36)
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [userId])
  restaurantId   String       @db.VarChar(36)
  job            Job          @relation(fields: [jobId], references: [id])
  jobId          String       @db.VarChar(36)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([professionalId, restaurantId, jobId, avaliadorRole])

  @@index([professionalId])
  @@index([restaurantId])
  @@index([jobId])
  @@map("avaliacoes")
}

model Denuncia {
  id         String             @id @default(uuid()) @db.VarChar(36)
  authorId   String             @map("author_id") @db.VarChar(36)
  targetType DenunciaTargetType @map("target_type")
  // Alvo polimórfico (perfil/vaga/mensagem) sem FK por ser de 3 tabelas
  // diferentes. PERFIL e VAGA são validados no use-case (existência +
  // ativo); MENSAGEM não valida porque o schema ainda não tem tabela de
  // chat. Ceiling: denúncia de mensagem aceita alvo inexistente.
  // Upgrade: validar MENSAGEM quando existir o módulo de mensagens.
  targetId   String             @map("target_id") @db.VarChar(36)
  reason     String             @db.Text
  status     DenunciaStatus     @default(PENDENTE)
  createdAt  DateTime           @default(now()) @map("created_at")
  author     User               @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@map("denuncias")
}
