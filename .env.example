DATABASE_URL=postgresql://user:password@localhost:5432/komanda?schema=public
JWT_SECRET=uma-string-forte-aqui
JWT_EXPIRES_IN=7d
PORT=3000
PASSWORD_RESET_TOKEN_PEPPER=troque-por-uma-string-aleatoria

# Máximo de conexões simultâneas que ESTE processo mantém abertas no Postgres.
# Cada worker/réplica abre seu próprio pool: DB_POOL_SIZE × nº de workers precisa
# caber no max_connections do servidor (default 100). Valor baixo = requisições
# na fila esperando conexão; valor alto demais = conexões recusadas pelo banco.
DB_POOL_SIZE=10