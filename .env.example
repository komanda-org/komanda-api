DATABASE_URL=postgresql://user:password@localhost:5432/komanda?schema=public
# Obrigatório, mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=3000
AUTH_LOGIN_LIMIT=5
AUTH_LOGIN_TTL_SECONDS=60
RATE_LIMIT=20
RATE_LIMIT_TTL_SECONDS=60
# Nº de proxies confiáveis à frente da API (X-Forwarded-For). 0 = sem proxy.
TRUST_PROXY_HOPS=0
# Obrigatório, mínimo 32 caracteres. Gere com: openssl rand -base64 48
PASSWORD_RESET_TOKEN_PEPPER=
DB_POOL_SIZE=10

#node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

# URL pública da API, usada para montar a URL das fotos de perfil.
# Vazio = http://localhost:$PORT
API_PUBLIC_URL=
